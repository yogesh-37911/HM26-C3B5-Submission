# Copy this file to .env and adjust as needed.
# See docs/setup.md for full instructions.

# --- Core ---
ENV=development

# SQLite is the zero-setup default. For Postgres/Supabase use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/civicpulse
DATABASE_URL=sqlite:///./civicpulse.db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720

# --- Uploads ---
MAX_UPLOAD_BYTES=5242880
EVIDENCE_DIR=./evidence_store

# --- Duplicate detection tuning ---
DUP_RADIUS_M=150
DUP_TIME_WINDOW_HOURS=336
DUP_MIN_SIMILARITY=0.55

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seed data ---
DEMO_PASSWORD=CivicPulse@2026
